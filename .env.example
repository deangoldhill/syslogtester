# PostgreSQL application database. Replace every placeholder with unique values.
POSTGRES_DB=syslog
POSTGRES_USER=syslog
POSTGRES_PASSWORD=replace-with-a-long-random-postgres-password

# HTTPS hostname handled by the existing Traefik instance.
SYSLOG_HOST=syslog.example.internal
TRAEFIK_NETWORK=traefik
# Authelia ForwardAuth endpoint reachable by Traefik (not by this app).
AUTHELIA_FORWARD_AUTH_URL=http://authelia:9091/api/authz/forward-auth

# Exact Authelia username permitted to use /admin and /api/admin/*.
SYSLOG_ADMIN_USER=dean
