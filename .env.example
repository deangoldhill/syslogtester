# First-run administrator. Use a unique password of at least 12 characters.
SYSLOG_ADMIN_USERNAME=admin
SYSLOG_ADMIN_PASSWORD=replace-this-with-a-long-unique-password

# Set true only when the browser accesses the dashboard through HTTPS.
# Keep false for direct HTTP on a trusted LAN.
SYSLOG_COOKIE_SECURE=false

# Web dashboard port on the Docker host.
WEB_PORT=8085
